.claude/
.venv/

# Obsidian vault — commit shared config, ignore per-user/per-machine state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/

# Historical_Papers — two-tier PDF policy.
# Default: ignore everything under Historical_Papers/. Public-domain PDFs are
# allow-listed back in per chapter via `git add -f` (see Bibliography/README.md +
# Historical_Papers/Acquisition_Tracker.md for the policy). The `.gitkeep` and
# `Acquisition_Tracker.md` files are committed via explicit !-rules below.
Roadmapping/Historical_Papers/**/*.pdf
Roadmapping/Historical_Papers/**/*.PDF
!Roadmapping/Historical_Papers/Acquisition_Tracker.md
!Roadmapping/Historical_Papers/**/.gitkeep

# Bibliography — generated BibTeX is regenerable from YAML.
Roadmapping/History/Bibliography/bibliography.bib

# Bibliography — Better-BibTeX-exported Zotero mirror (regeneratable from
# the Zotero local library; not committed). The YAML stubs under
# Bibliography/{Primary,Retrospective}/ remain canonical.
Roadmapping/History/Bibliography/zotero.bib

# Triage pipeline raw crawler outputs (Phase 3+; regeneratable).
Roadmapping/Tooling/triage/_inbox/

# Podcast — audio is regenerable from scripts (Phase 10 / PR L only).
Roadmapping/History/Podcast/audio/*.mp3
Roadmapping/History/Podcast/audio/*.wav
Roadmapping/History/Podcast/video/
